<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Kobe Library</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,500;6..72,600&display=swap" rel="stylesheet" />
    <style>
        :root {
            color-scheme: light;
            --ink: #183832;
            --ink-soft: #426057;
            --muted: #71827a;
            --line: #dce4dc;
            --paper: #f4f6f1;
            --surface: #fff;
            --leaf: #dce9d7;
            --leaf-dark: #305e48;
            --coral: #db684b;
            --sun: #f1c46c;
            --shadow: 0 12px 34px #193b3010;
        }
        * { box-sizing: border-box; }
        body { margin: 0; background: var(--paper); color: var(--ink); font-family: "DM Sans", "Segoe UI", sans-serif; font-size: 14px; line-height: 1.5; }
        a { color: inherit; }
        .topbar { background: var(--ink); color: #f6f7f1; }
        .topbar-inner, .page-shell { width: min(1320px, 100%); margin: 0 auto; padding-right: 36px; padding-left: 36px; }
        .topbar-inner { min-height: 82px; display: flex; align-items: center; justify-content: space-between; gap: 28px; }
        .brand { display: flex; align-items: center; gap: 13px; min-width: 230px; text-decoration: none; }
        .brand-mark { display: grid; place-items: center; width: 38px; height: 38px; border: 1px solid #ffffff4a; border-radius: 50%; color: var(--sun); font-family: "Newsreader", Georgia, serif; font-size: 20px; }
        .brand-name { display: block; font-size: 14px; font-weight: 700; letter-spacing: 0; }
        .brand-caption { display: block; margin-top: 1px; color: #b7c8be; font-size: 11px; }
        .nav { display: flex; align-items: center; gap: 5px; }
        .nav a { padding: 9px 13px; border-radius: 5px; color: #c4d0c9; font-size: 13px; text-decoration: none; transition: background .18s ease, color .18s ease; }
        .nav a:hover, .nav a.active { background: #ffffff18; color: #fff; }
        .nav a.active { box-shadow: inset 0 -2px var(--sun); }
        .topbar-date { color: #c4d0c9; font-size: 12px; white-space: nowrap; }
        .page-shell { padding-top: 34px; padding-bottom: 48px; }
        main { animation: arrive .4s ease both; }
        @@keyframes arrive { from { opacity: 0; transform: translateY(7px); } to { opacity: 1; transform: translateY(0); } }
        .page-heading { display: flex; align-items: end; justify-content: space-between; gap: 20px; margin-bottom: 24px; }
        .eyebrow { margin: 0 0 7px; color: var(--leaf-dark); font-size: 11px; font-weight: 700; letter-spacing: 0; text-transform: uppercase; }
        .page-heading h1, .welcome h2 { margin: 0; font-family: "Newsreader", Georgia, serif; font-weight: 500; letter-spacing: 0; }
        .page-heading h1 { font-size: 34px; line-height: 1.1; }
        .page-heading p:last-child { margin: 8px 0 0; color: var(--muted); }
        .date-chip { padding: 8px 12px; border: 1px solid var(--line); border-radius: 5px; color: var(--ink-soft); background: #ffffffa8; font-size: 12px; white-space: nowrap; }
        .grid { display: grid; gap: 18px; }
        .split { grid-template-columns: minmax(270px, 330px) minmax(0, 1fr); align-items: start; }
        .panel { overflow: hidden; border: 1px solid var(--line); border-radius: 7px; background: var(--surface); box-shadow: var(--shadow); }
        .panel-title { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: 0; padding: 15px 18px; border-bottom: 1px solid var(--line); font-size: 14px; font-weight: 700; }
        .panel-body { padding: 18px; }
        .metric-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); margin-bottom: 20px; }
        .metric { position: relative; min-height: 142px; padding: 19px; }
        .metric::after { position: absolute; top: 0; right: 0; width: 5px; height: 100%; background: var(--metric-accent, var(--leaf-dark)); content: ""; }
        .metric-label { display: flex; align-items: center; gap: 8px; color: var(--ink-soft); font-size: 12px; font-weight: 600; }
        .metric-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--metric-accent, var(--leaf-dark)); }
        .metric strong { display: block; margin-top: 14px; font-family: "Newsreader", Georgia, serif; font-size: 36px; font-weight: 500; line-height: 1; }
        .metric span:last-child { display: block; margin-top: 9px; color: var(--muted); font-size: 12px; }
        .welcome { position: relative; display: flex; min-height: 205px; align-items: center; justify-content: space-between; gap: 28px; overflow: hidden; padding: 28px 32px; border-radius: 7px; background: var(--leaf); }
        .welcome::after { position: absolute; top: -70px; right: 13%; width: 260px; height: 260px; border: 1px solid #305e4820; border-radius: 50%; box-shadow: 0 0 0 22px #305e4808, 0 0 0 46px #305e4806; content: ""; pointer-events: none; }
        .welcome-copy { position: relative; z-index: 1; max-width: 520px; }
        .welcome .eyebrow { color: var(--leaf-dark); }
        .welcome h2 { max-width: 480px; font-size: 32px; line-height: 1.12; }
        .welcome p:last-child { margin: 10px 0 0; color: var(--ink-soft); }
        .welcome-actions { position: relative; z-index: 1; display: flex; flex-wrap: wrap; gap: 9px; }
        .button { display: inline-flex; min-height: 39px; align-items: center; justify-content: center; gap: 7px; padding: 9px 13px; border: 1px solid var(--line); border-radius: 5px; background: var(--surface); color: var(--ink); font: inherit; font-size: 12px; font-weight: 700; text-decoration: none; cursor: pointer; transition: transform .16s ease, background .16s ease, border-color .16s ease; }
        .button:hover { transform: translateY(-1px); border-color: #9bb0a2; }
        .button.primary { border-color: var(--ink); background: var(--ink); color: #fff; }
        .button.primary:hover { background: #285247; }
        .button.coral { border-color: var(--coral); background: var(--coral); color: #fff; }
        .button.subtle { background: transparent; }
        label { display: block; margin: 13px 0 5px; color: var(--ink-soft); font-size: 12px; font-weight: 700; }
        input, select { width: 100%; min-height: 39px; padding: 8px 10px; border: 1px solid #cad6cc; border-radius: 5px; background: #fff; color: var(--ink); font: inherit; font-size: 13px; }
        input:focus, select:focus { border-color: var(--leaf-dark); outline: 3px solid #305e481a; }
        .actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 17px; }
        .table-wrap { overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; }
        th, td { padding: 12px 14px; border-bottom: 1px solid #e8ede8; text-align: left; font-size: 12px; vertical-align: middle; }
        th { background: #f7f9f6; color: var(--muted); font-size: 10px; font-weight: 700; letter-spacing: 0; text-transform: uppercase; white-space: nowrap; }
        tbody tr:hover { background: #f8faf7; }
        tbody tr:last-child td { border-bottom: 0; }
        small, .muted { color: var(--muted); }
        .badge { display: inline-flex; align-items: center; padding: 4px 8px; border-radius: 4px; background: #e4efe1; color: #315b43; font-size: 11px; font-weight: 700; white-space: nowrap; }
        .badge.out { background: #f8e4de; color: #984a35; }
        .notice { margin-bottom: 14px; padding: 11px 12px; border: 1px solid #efb9a8; border-radius: 5px; background: #fff3ef; color: #873e2d; }
        .empty { padding: 36px 20px; color: var(--muted); text-align: center; }
        .muted { font-size: 12px; }
        @@media (max-width: 900px) {
            .topbar-inner, .page-shell { padding-right: 22px; padding-left: 22px; }
            .topbar-date { display: none; }
            .metric-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .split { grid-template-columns: minmax(240px, 300px) minmax(0, 1fr); }
        }
        @@media (max-width: 680px) {
            .topbar-inner { min-height: unset; align-items: flex-start; flex-direction: column; gap: 14px; padding-top: 16px; padding-bottom: 12px; }
            .nav { width: 100%; overflow-x: auto; }
            .nav a { padding: 8px 10px; white-space: nowrap; }
            .page-shell { padding: 25px 16px 36px; }
            .page-heading { align-items: flex-start; flex-direction: column; gap: 12px; }
            .page-heading h1 { font-size: 30px; }
            .split { grid-template-columns: 1fr; }
            .welcome { align-items: flex-start; flex-direction: column; padding: 24px 21px; }
            .welcome h2 { font-size: 28px; }
            .welcome-actions { width: 100%; }
        }
        @@media (max-width: 420px) {
            .metric-grid { gap: 10px; }
            .metric { min-height: 126px; padding: 14px; }
            .metric strong { font-size: 31px; }
            th, td { padding: 10px; }
        }
        @@media (prefers-reduced-motion: reduce) {
            *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; scroll-behavior: auto !important; }
        }
    </style>
</head>
<body>
    <header class="topbar">
        <div class="topbar-inner">
            <a class="brand" href="/" aria-label="Kobe Library dashboard">
                <span class="brand-mark" aria-hidden="true">K</span>
                <span><span class="brand-name">KOBE LIBRARY</span><span class="brand-caption">Collection services</span></span>
            </a>
            <nav class="nav" aria-label="Main navigation">
                <a class="@(ViewData["Title"]?.ToString() == "Dashboard" ? "active" : "")" href="/" aria-current="@(ViewData["Title"]?.ToString() == "Dashboard" ? "page" : null)">Overview</a>
                <a class="@(ViewData["Title"]?.ToString() == "Books" ? "active" : "")" href="/Books" aria-current="@(ViewData["Title"]?.ToString() == "Books" ? "page" : null)">Books</a>
                <a class="@(ViewData["Title"]?.ToString() == "Students" ? "active" : "")" href="/Students" aria-current="@(ViewData["Title"]?.ToString() == "Students" ? "page" : null)">Students</a>
                <a class="@(ViewData["Title"]?.ToString() == "Loans" ? "active" : "")" href="/Loans" aria-current="@(ViewData["Title"]?.ToString() == "Loans" ? "page" : null)">Loans</a>
            </nav>
            <span class="topbar-date">Campus library · @DateTime.Today.ToString("MMMM yyyy")</span>
        </div>
    </header>
    <div class="page-shell">
        <main>@RenderBody()</main>
    </div>
</body>
</html>